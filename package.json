{
  "name": "jsonl-gazelle",
  "displayName": "JSONL Gazelle",
  "description": "Fast JSONL / NDJSON viewer / editor for VS Code with advanced features including Table View and Pretty Print view.",
  "version": "0.6.2",
  "publisher": "gabor",
  "icon": "jsonl-gazelle.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "jsonl",
    "ndjson",
    "newline-delimited json",
    "json",
    "data",
    "table",
    "viewer",
    "csv",
    "export",
    "ai",
    "openai",
    "anthropic",
    "claude",
    "gemini"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gaborcselle/jsonl-gazelle.git"
  },
  "homepage": "https://github.com/gaborcselle/jsonl-gazelle",
  "bugs": {
    "url": "https://github.com/gaborcselle/jsonl-gazelle/issues"
  },
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:jsonl-gazelle.jsonlViewer",
    "onCommand:jsonl-gazelle.openLargeFile",
    "onCommand:jsonl-gazelle.exportCSV",
    "onCommand:jsonl-gazelle.openSettings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "jsonl-gazelle.jsonlViewer",
        "displayName": "JSONL Gazelle",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "jsonl-gazelle.openSettings",
        "title": "Open Settings",
        "category": "JSONL Gazelle"
      },
      {
        "command": "jsonl-gazelle.exportCSV",
        "title": "JSONL Gazelle: Export to CSV..."
      },
      {
        "command": "jsonl-gazelle.openLargeFile",
        "title": "Split Large File into Parts",
        "category": "JSONL Gazelle",
        "icon": "$(file)"
      },
      {
        "command": "jsonl-gazelle.refresh",
        "title": "Refresh from Disk",
        "category": "JSONL Gazelle"
      },
      {
        "command": "jsonl-gazelle.diffWithHead",
        "title": "JSONL Gazelle: Diff with Git HEAD",
        "icon": "$(git-compare)"
      },
      {
        "command": "jsonl-gazelle.compareFiles",
        "title": "JSONL Gazelle: Compare with JSONL File..."
      }
    ],
    "keybindings": [
      {
        "command": "jsonl-gazelle.refresh",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeCustomEditorId == 'jsonl-gazelle.jsonlViewer'"
      },
      {
        "command": "jsonl-gazelle.refresh",
        "key": "f5",
        "when": "activeCustomEditorId == 'jsonl-gazelle.jsonlViewer'"
      }
    ],
    "configuration": {
      "title": "JSONL Gazelle",
      "properties": {
        "jsonl-gazelle.files.extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$",
            "patternErrorMessage": "Extension must start with a dot, e.g. .jsonl"
          },
          "uniqueItems": true,
          "default": [
            ".jsonl",
            ".ndjson"
          ],
          "scope": "resource",
          "description": "The file extensions that Gazelle should use to determine if a file is a JSONL file. Files with these extensions also open with JSONL Gazelle by default (via workbench.editorAssociations)."
        },
        "jsonl-gazelle.largeFile.splitThresholdMB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "File size in MB above which JSONL Gazelle suggests splitting the file into parts."
        },
        "jsonl-gazelle.largeFile.partSizeMB": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Maximum size in MB of each part when splitting a large file."
        },
        "jsonl-gazelle.performance.chunkedLoadingThreshold": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "description": "Files with more lines than this are loaded progressively in chunks."
        },
        "jsonl-gazelle.performance.maxMemoryRows": {
          "type": "number",
          "default": 50000,
          "minimum": 1000,
          "description": "Maximum number of rows kept in memory for very large files. Above this, memory-optimized mode keeps only the most recent rows in the table view."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "jsonl-gazelle.openSettings",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions"
        },
        {
          "command": "jsonl-gazelle.refresh",
          "when": "activeCustomEditorId == 'jsonl-gazelle.jsonlViewer'"
        },
        {
          "command": "jsonl-gazelle.exportCSV",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions"
        },
        {
          "command": "jsonl-gazelle.openLargeFile",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions"
        },
        {
          "command": "jsonl-gazelle.diffWithHead",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions"
        },
        {
          "command": "jsonl-gazelle.compareFiles",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions"
        }
      ],
      "explorer/context": [
        {
          "command": "jsonl-gazelle.exportCSV",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions",
          "group": "navigation"
        },
        {
          "command": "jsonl-gazelle.openLargeFile",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions",
          "group": "navigation"
        },
        {
          "command": "jsonl-gazelle.diffWithHead",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions",
          "group": "3_compare"
        },
        {
          "command": "jsonl-gazelle.compareFiles",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions",
          "group": "3_compare"
        }
      ],
      "editor/title/context": [
        {
          "command": "jsonl-gazelle.exportCSV",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "jsonl-gazelle.exportCSV",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "jsonl-gazelle.diffWithHead",
          "when": "resourceExtname in jsonl-gazelle.fileExtensions",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "jsonl-gazelle.diffWithHead",
          "when": "scmProvider == git && (resourceExtname in jsonl-gazelle.fileExtensions)",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node16 --minify",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/rowMapping.test.js && node test/sorting.test.js && node test/prettyToJsonl.test.js && node test/diff.test.js && node test/webviewScripts.test.js && node test/sortJumpNotice.test.js && node test/columns.test.js && node test/columnVisibility.test.js && node test/hiddenColumnsBadge.test.js",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.11",
    "eslint": "^9.0.0",
    "globals": "^17.9.0",
    "typescript": "^4.9.4",
    "typescript-eslint": "^8.66.0"
  }
}
